<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Per installare i propri aggiornamenti scaricati da GitHub (Android chiede il consenso una volta) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Per registrare un audio dall'app (resta solo in memoria) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_android12"
        android:fullBackupContent="@xml/backup"
        android:icon="@drawable/ic_launcher"
        android:label="TapiTranscriber"
        android:supportsRtl="true"
        android:theme="@style/Tema">

        <!-- Schermata principale: registra, scegli un audio, condividi l'app -->
        <activity
            android:name=".PrincipaleActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Impostazioni: chiavi API, lingua, aggiornamenti -->
        <activity
            android:name=".ImpostazioniActivity"
            android:exported="false" />

        <!-- Fornisce l'APK da condividere (sola lettura, solo a chi riceve il permesso) -->
        <provider
            android:name=".ProviderApk"
            android:authorities="app.tapitranscriber.condividi"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Riceve l'audio da "Condividi" o "Apri con" e mostra la trascrizione in un popup -->
        <activity
            android:name=".TrascriviActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="TapiTranscriber"
            android:taskAffinity=""
            android:theme="@style/Tema.Trasparente">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Esito dell'installazione di un aggiornamento -->
        <receiver
            android:name=".EsitoInstallazione"
            android:exported="false" />
    </application>
</manifest>
